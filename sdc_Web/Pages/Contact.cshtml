@page
@model sdc_Web.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us";
}

<h1>@ViewData["Title"]</h1>
<section class="testimonials text-center bg-light">
    <div class="container">
        <form method="post" asp-controller="Contact" asp-antiforgery="true" id="contactForm" style="width:50%;">
            <div class="row">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" type="text" required aria-required="true" />
            </div>
            <div class="row">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="text" required aria-required="true" />
            </div>
            <div class="row">
                <label asp-for="QuestionComment">Question or Comment</label>
                <input asp-for="QuestionComment" type="text" required aria-required="true" />
            </div>
            <button>Submit</button>
        </form> 
        
    </div>
</section>



