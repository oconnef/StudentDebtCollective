<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Debt Collective</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sdc_Web.styles.css" asp-append-version="true" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" type="text/css" />
    <!-- Google fonts-->
    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700,300italic,400italic,700italic" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"></script>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-217164909-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-217164909-1');
    </script>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/Index">Student Debt Collective</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item"><a class="nav-link" href="#about">About Us</a></li>
                        <!--
                        <li class="nav-item"><a class="nav-link" href="#newsletter">Newsletter</a></li>
                        <li class="nav-item"><a class="nav-link" href="#subscription">Subscription</a></li>
                        <li class="nav-item"><a class="nav-link" href="#success-stories">Success Stories</a></li>
                        -->
                        <li class="nav-item">
                        <a class="nav-link" runat="server" href="~/Contact">Contact Us</a>
                    </li>
                    </ul>
                </div>
            </div>
        </nav>
    
    <header class="hero" style="background-image:unset;">
        <!-- Hero Section -->
        <div class="col-md-6">
            <section class="hero d-flex align-items-center justify-content-center">
                <div class="container text-center hero-content">
                </div>
            </section>
        </div>
        <div class="col-md-6">
            <section class="d-flex align-items-center justify-content-center">
                <div class="container text-center hero-content">
                    <h1>Join the Collective.<br>Overcome Student Debt Together.</h1>
                    <form id="newsletter-form" action="#" method="POST" class="mt-4">
                        <div class="row justify-content-center">
                            <div class="col-md-8 mb-3 mb-sm-0">
                                <div class="input-group">
                                    <input type="email" id="email" name="email" class="form-control"
                                           placeholder="Enter your email address" required>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <button type="submit" class="btn btn-primary btn-block">Subscribe</button>
                            </div>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="page-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h4>Company</h4>
                    <ul>
                        <li><a runat="server" href="~/Privacy">Privacy Policy</a></li>
                        <li><a runat="server" href="~/Terms">Terms and Conditions</a></li>
                        <li><a runat="server" href="~/Contact">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>Connect with Us</h4>
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item me-4">
                            <a href="https://www.facebook.com/Fckstudentloanscom-109881688240282" target="_blank">
                                <i class="bi-facebook fs-3"></i>
                            </a>
                        </li>
                        <li class="list-inline-item me-4">
                            <a href="https://twitter.com/FckStudentLns" target="_blank"><i class="bi-twitter fs-3"></i></a>
                        </li>
                        <li class="list-inline-item">
                            <a href="https://www.instagram.com/fckstudentlns/" target="_blank"><i class="bi-instagram fs-3"></i></a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>Subscribe</h4>
                    <p>Subscribe to our newsletter for monthly updates and a chance to win!</p>
                    <form id="footer-newsletter-form" action="#" method="POST" class="mt-4">
                        <div class="row justify-content-center">
                            <div class="col-md-8 mb-3 mb-sm-0">
                                <div class="input-group">
                                    <input type="email" id="email" name="email" class="form-control"
                                           placeholder="Enter your email address" required>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <button type="submit" class="btn btn-primary btn-block">Subscribe</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="row">
                © StudentDebtCollective.com. All Rights Reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>