@model List<Article>
@{
    ViewData["Title"] = "Past Newsletters";
}
<h1>Newsletters</h1>
<ul>
    @foreach (var article in Model)
    {
        <li>
            <i>[@article.PublicationDate.ToShortDateString()]</i> - <a href="@Url.Action("Article", "Blog", new { id = article.Id })">@article.Title</a>
        </li>
    }
</ul>

