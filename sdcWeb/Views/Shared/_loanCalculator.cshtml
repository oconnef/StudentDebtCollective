@{

}
<style>
    table {
        width: 100%;
        margin-top: 10px;
        border: 1px solid;
    }

    table .headerRow{
        background-color: #009999;
        color: white;
    }

    table td {
        text-align:center;
    }
</style>
<div class="row">
    <h1 style="margin:auto auto;text-align:center;">Using a Lump Sum to Pay Down Debt</h1>
    <p class="text-muted" style="margin:auto auto; text-align:center;">Enter your loan information below to see what a lump sum payment could do for you!</p>
</div>
<div class="row"><br /><br /></div>
<div class="row">
    <div class="col-md-3">
        <div>
            <h3 style="color: #009999;font-weight:bolder;">Enter Loan Details</h3>
        </div>
        <div style="margin-top:10px;">
            <label>Remaining Loan Balance:</label>
            <input type="number" id="balance" class="form-control" step="1" min="0" value="50000" />
        </div>
        <div style="margin-top:10px;">
            <label>Interest Rate:</label>
            <input type="number" id="interestRate" class="form-control" step="0.01" min="0" value="5.00" />
        </div>
        <div style="margin-top:10px;">
            <label>Monthly Payment:</label>
            <input type="number" id="monthlyPayment" class="form-control" step="1" min="0" value="250" />
        </div>
        <div style="margin-top:10px;">
            <label>Lump Sum Payment:</label>
            <input type="number" id="lumpSum" class="form-control" step="1" min="0" value="5000" />
        </div>
    </div>
    <div class="col-md-9">
        <table style="border:unset;">            
            <tr>
                <td colspan="2">
                    <div class="row">
                        <div class="col-lg-6">
                            <table>
                                <tr class="headerRow" style="text-align:center;">
                                    <td colspan="3">
                                        <h3 style="margin:auto auto;text-align:center;">Current Plan</h3>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:33%;">Total Amount</td>
                                    <td style="width:33%;">Total Interest</td>
                                    <td style="width:33%;">Payments</td>
                                </tr>
                                <tr style="text-align:center;">
                                    <td style="width:33%;"><span id="calcAmount">50000</span></td>
                                    <td style="width:33%;"><span id="calcInterest">5000</span></td>
                                    <td style="width:33%;"><span id="calcPymts">500</span></td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <br />
                                        <p class="text-muted" style="text-align:center;margin:auto auto;">Payoff Date: <span id="currentPayoffDate"></span></p>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-lg-6">
                            <table>
                                <tr class="headerRow" style="text-align:center;">
                                    <td colspan="3">
                                        <h3 style="margin:auto auto;text-align:center;">With Lump Sum</h3>
                                    </td>
                                </tr>
                                <tr style="text-align:center;">
                                    <td style="width:33%;">Total Amount</td>
                                    <td style="width:33%;">Total Interest</td>
                                    <td style="width:33%;">Payments</td>
                                </tr>
                                <tr style="text-align:center;">
                                    <td style="width:33%;"><span id="lumpAmount">50000</span></td>
                                    <td style="width:33%;"><span id="lumpInterest">5000</span></td>
                                    <td style="width:33%;"><span id="lumpPymts">500</span></td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="margin:auto auto;">
                                        <br />
                                        <p class="text-muted" style="text-align:center;margin:auto auto;">Payoff Date: <span id="lumpPayoffDate"></span></p>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                </td>
            </tr>
            <tr>
                <td colspan=2>
                    <h2 style="margin:auto auto; margin-top: 10px;text-align:center;">
                        By making a lump sum payment, you will repay your loan <span id="diffMonths" class="text-emphasis" style="font-weight:bolder;">58</span>
                        months earlier and save
                        <span id="diffDollars" class="text-emphasis" style="font-weight:bolder;">$9,618</span> in total over the remaining term of the loan.
                    </h2>
                </td>
            </tr>
        </table>
    </div>

    <div class="row text-muted" style="margin:auto auto;width:90%;"><br />*The accuracy of this calculator is not guaranteed by Student Debt Collective and is intended for informational purposes only.</div>
</div>


<script>
    $(document).ready(function () {
        callCalc(50000, 5.00, 250, 5000);
    });

    const callCalc = function (t, i, p, l) {
        const loanPayoffInfo = calculateLoanPayoff(t, i, p, l);

        $('#calcAmount').text(loanPayoffInfo.withoutLumpSum.totalAmountRepaid);
        $('#calcInterest').text(loanPayoffInfo.withoutLumpSum.totalInterest);
        $('#calcPymts').text(loanPayoffInfo.withoutLumpSum.months);
        $('#currentPayoffDate').text(loanPayoffInfo.withoutLumpSum.payoffDate);

        $('#lumpAmount').text(loanPayoffInfo.withLumpSum.totalAmountRepaid);
        $('#lumpInterest').text(loanPayoffInfo.withLumpSum.totalInterest);
        $('#lumpPymts').text(loanPayoffInfo.withLumpSum.months);
        $('#lumpPayoffDate').text(loanPayoffInfo.withLumpSum.payoffDate);

        $('#diffDollars').text(loanPayoffInfo.diff.total);
        $('#diffMonths').text(loanPayoffInfo.diff.months);
    };

    const currencyFormatter = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
    });

    const doCalc = function () {
        //get vals and call
        const t = $('#balance').val();
        const i = $('#interestRate').val();
        const p = $('#monthlyPayment').val();
        const l = $('#lumpSum').val();

        callCalc(t, i, p, l);
    };

    $('#balance').on('blur', doCalc);
    $('#interestRate').on('blur', doCalc);
    $('#monthlyPayment').on('blur', doCalc);
    $('#lumpSum').on('blur', doCalc);

    function calculateLoanPayoff(loanBalance, interestRate, monthlyPayment, lumpSumPayment) {
        // Convert interest rate to decimal
        interestRate = interestRate / 100;

        // Calculate monthly interest rate
        let monthlyInterestRate = interestRate / 12;

        // Initialize variables for with lump sum and without lump sum scenarios
        let monthsWithLumpSum = 0;
        let totalInterestWithLumpSum = 0;
        let totalAmountRepaidWithLumpSum = 0;

        let monthsWithoutLumpSum = 0;
        let totalInterestWithoutLumpSum = 0;
        let totalAmountRepaidWithoutLumpSum = 0;

        // Calculate loan payoff with lump sum
        let remainingBalanceWithLumpSum = loanBalance;
        while (remainingBalanceWithLumpSum > 0) {
            monthsWithLumpSum++;

            // Calculate interest for the month
            let interestForMonth = remainingBalanceWithLumpSum * monthlyInterestRate;
            totalInterestWithLumpSum += interestForMonth;

            // Calculate principal paid for the month
            let principalPaid = monthlyPayment - interestForMonth;

            // Apply lump sum payment if applicable
            if (lumpSumPayment > 0) {
                if (parseInt(lumpSumPayment) >= parseInt(remainingBalanceWithLumpSum)) {
                    lumpSumPayment -= remainingBalanceWithLumpSum;
                    remainingBalanceWithLumpSum = 0;
                } else {
                    remainingBalanceWithLumpSum -= lumpSumPayment;
                    //totalAmountRepaidWithLumpSum += lumpSumPayment;
                    lumpSumPayment = 0;
                }
            }

            // Update remaining balance
            remainingBalanceWithLumpSum -= principalPaid;

            // Update total amount repaid
            totalAmountRepaidWithLumpSum += (principalPaid + interestForMonth);
        }

        // Calculate loan payoff without lump sum
        let remainingBalanceWithoutLumpSum = loanBalance;
        while (remainingBalanceWithoutLumpSum > 0) {
            monthsWithoutLumpSum++;

            // Calculate interest for the month
            let interestForMonth = remainingBalanceWithoutLumpSum * monthlyInterestRate;
            totalInterestWithoutLumpSum += interestForMonth;

            // Calculate principal paid for the month
            let principalPaid = monthlyPayment - interestForMonth;

            // Update remaining balance
            remainingBalanceWithoutLumpSum -= principalPaid;

            // Update total amount repaid
            totalAmountRepaidWithoutLumpSum += (principalPaid + interestForMonth);
        }

        const today = new Date();
        let lumpDate = new Date();
        let noLumpDate = new Date();

        lumpDate.setMonth(today.getMonth() + monthsWithLumpSum);
        noLumpDate.setMonth(today.getMonth() + monthsWithoutLumpSum);

        return {
            withLumpSum: {
                months: monthsWithLumpSum,
                totalInterest: currencyFormatter.format(totalInterestWithLumpSum),
                totalAmountRepaid: currencyFormatter.format(totalAmountRepaidWithLumpSum),
                payoffDate: lumpDate.toLocaleDateString()
            },
            withoutLumpSum: {
                months: monthsWithoutLumpSum,
                totalInterest: currencyFormatter.format(totalInterestWithoutLumpSum),
                totalAmountRepaid: currencyFormatter.format(totalAmountRepaidWithoutLumpSum),
                payoffDate: noLumpDate.toLocaleDateString()
            },
            diff: {
                months: monthsWithoutLumpSum - monthsWithLumpSum,
                total: currencyFormatter.format(totalAmountRepaidWithoutLumpSum - totalAmountRepaidWithLumpSum)
            }
        };
    }

</script>
