@model ContactReceivedModel

@{
    ViewData["Title"] = "Contact Received";
}

<h1>Contact Received</h1>

<hr />
<div class="row">
    <div class="col-lg-12">
        <h1>Hey @Model.Name</h1>
        <h1>Thanks for reaching out to us!</h1>
        <p>
            We'll get back to you ASAP and do our best to answer your question or comment with zeal!    
        </p>
    </div>
</div>

